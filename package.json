{
  "name": "dsh-hemorrhoid",
  "version": "0.1.0",
  "description": "给 DeepSeek Harness 的一条「久坐副线」：内痔 / 外痔 / 混合痔三种型号，各自的疼痛、失血、脱出惩罚，按真实久坐时长累积，发作时把对话语气拧到不对劲。默认非全局、按会话开关、可随时关掉。",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "panel",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/pain.test.mjs test/plugin.smoke.mjs",
    "check": "node --check src/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "persona",
    "roleplay",
    "hemorrhoid"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
